# Kisaan Mitra Frontend Environment Variables

# ============================================
# SUPABASE DATABASE (Required for Data Storage)
# ============================================

# Supabase Project URL
# Get it from: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://kdxdvqlezegfkajwheuf.supabase.co

# Supabase Anon/Public Key (safe for client-side)
# Get it from: https://supabase.com/dashboard → Project Settings → API → anon/public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (server-side only, keep secret!)
# Get it from: https://supabase.com/dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ============================================
# LLM API KEYS (Required for AI Features)
# ============================================

# Google Gemini API Key (Primary AI - Required)
# Get it from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# OpenRouter API Key (Secondary/Fallback AI - Recommended)
# Get it from: https://openrouter.ai/keys
# Used when Gemini fails or for Amazon Nova fallback
OPENROUTER_API_KEY=your-openrouter-api-key

# Perplexity API Key (For real-time search - Optional)
# Get it from: https://www.perplexity.ai/settings/api
# Used for government schemes and market prices
PERPLEXITY_API_KEY=your-perplexity-api-key

# ============================================
# OPTIONAL: Backend API (Only if using Express backend)
# ============================================
# NEXT_PUBLIC_API_URL=http://localhost:5000
